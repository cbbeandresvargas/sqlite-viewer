import { ScrollView, TextEdit } from "std-widgets.slint";

// ---------- Tokens de diseño (VS Code Dark / Charcoal, compacto) ----------
export global Theme {
    // Superficies
    out property <color> bg: #1e1e1e;
    out property <color> sidebar: #181818;
    out property <color> panel: #252526;
    out property <color> header: #202020;
    out property <color> border: #2b2b2b;
    out property <color> border-strong: #3a3a3a;
    // Texto
    out property <color> text: #cccccc;
    out property <color> text-strong: #ececec;
    out property <color> muted: #7a7a7a;
    out property <color> faint: #5a5a5a;
    // Acentos
    out property <color> accent: #4fc1ff;
    out property <color> accent-bg: #0078d4;
    out property <color> number: #b5cea8;
    out property <color> null: #6a6a6a;
    // Estados
    out property <color> hover: #2a2d2e;
    out property <color> selected: #04395e;
    out property <color> row-alt: #1b1b1b;
    out property <color> error-bg: #6e1f1f;
    // Escala compacta
    out property <length> fs: 12px;
    out property <length> fs-small: 11px;
    out property <length> fs-tiny: 10px;
    out property <length> radius: 3px;
}

// ---------- Componentes reutilizables ----------
component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 24px;
    min-width: 24px;
    border-radius: Theme.radius;
    background: !root.enabled ? transparent
        : root.primary ? (ta.pressed ? Theme.accent-bg.darker(15%) : ta.has-hover ? Theme.accent-bg.brighter(15%) : Theme.accent-bg)
        : (ta.pressed ? Theme.border-strong : ta.has-hover ? Theme.hover : transparent);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border-strong;
    opacity: root.enabled ? 1.0 : 0.35;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: root.text == "" ? 6px : 10px;
        padding-right: root.text == "" ? 6px : 10px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Text {
            text: root.icon;
            color: root.primary ? #ffffff : Theme.text;
            font-size: Theme.fs;
            vertical-alignment: center;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? #ffffff : Theme.text;
            font-size: Theme.fs;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: Theme.fs-tiny;
    font-weight: 700;
    letter-spacing: 0.6px;
}

component Badge inherits Rectangle {
    in property <string> text;
    height: 16px;
    border-radius: 8px;
    background: Theme.border-strong;
    visible: root.text != "";
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        Text { text: root.text; color: Theme.text; font-size: Theme.fs-tiny; vertical-alignment: center; }
    }
}

component TableItem inherits Rectangle {
    in property <string> name;
    in property <bool> active;
    callback clicked;

    height: 22px;
    background: root.active ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);

    Rectangle {
        x: 0; width: 2px;
        background: root.active ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 7px;
        Text { text: "▦"; color: root.active ? Theme.accent : Theme.muted; vertical-alignment: center; font-size: Theme.fs-small; }
        Text {
            text: root.name;
            color: root.active ? Theme.text-strong : Theme.text;
            font-size: Theme.fs;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Tabla de datos con cabecera fija, columna de índice y columnas dinámicas.
component DataTable inherits Rectangle {
    in property <[string]> columns;
    in property <[[string]]> rows;
    in property <int> row-offset: 0;
    property <length> col-w: 150px;
    property <length> row-h: 22px;
    property <length> num-w: 44px;

    background: Theme.bg;

    sv := ScrollView {
        content-width: max(root.width, root.num-w + root.columns.length * root.col-w);
        content-height: (root.rows.length + 1) * root.row-h;

        for row[i] in root.rows: Rectangle {
            x: 0;
            y: (i + 1) * root.row-h;
            height: root.row-h;
            width: sv.content-width;
            background: rta.has-hover ? Theme.hover : (Math.mod(i, 2) == 0 ? Theme.bg : Theme.row-alt);
            rta := TouchArea { }

            Text {
                x: 0; width: root.num-w - 10px;
                height: parent.height;
                text: root.row-offset + i + 1;
                color: Theme.faint;
                font-size: Theme.fs-tiny;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            for cell[j] in row: Text {
                x: root.num-w + j * root.col-w + 8px;
                width: root.col-w - 16px;
                height: parent.height;
                text: cell;
                color: cell == "NULL" ? Theme.null : Theme.text;
                font-italic: cell == "NULL";
                font-size: Theme.fs;
                vertical-alignment: center;
                overflow: elide;
            }
            // Separadores verticales sutiles
            for col[j] in root.columns: Rectangle {
                x: root.num-w + j * root.col-w;
                width: 1px;
                background: Theme.border;
            }
        }

        // Cabecera "sticky": se dibuja al final para quedar encima.
        Rectangle {
            x: 0;
            y: -sv.content-y;
            height: root.row-h;
            width: sv.content-width;
            background: Theme.header;

            Text {
                x: 0; width: root.num-w - 10px; height: parent.height;
                text: "#"; color: Theme.faint; font-size: Theme.fs-tiny;
                horizontal-alignment: right; vertical-alignment: center;
            }
            for col[j] in root.columns: Rectangle {
                x: root.num-w + j * root.col-w;
                width: root.col-w;
                height: parent.height;
                Text {
                    x: 8px; width: parent.width - 16px;
                    height: parent.height;
                    text: col;
                    color: Theme.text-strong;
                    font-size: Theme.fs-small;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { x: 0; width: 1px; background: Theme.border-strong; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-strong; }
        }
    }

    // Estado vacío
    if root.columns.length == 0: VerticalLayout {
        alignment: center;
        spacing: 6px;
        Text { text: "▦"; color: Theme.border-strong; font-size: 34px; horizontal-alignment: center; }
        Text { text: "No hay datos para mostrar"; color: Theme.muted; font-size: Theme.fs; horizontal-alignment: center; }
        Text { text: "Abre una base de datos y selecciona una tabla, o ejecuta una consulta."; color: Theme.faint; font-size: Theme.fs-small; horizontal-alignment: center; }
    }
}

// ---------- Ventana principal ----------
export component AppWindow inherits Window {
    title: "SQLite Viewer";
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.bg;
    default-font-size: 12px;

    in property <string> file-name: "Ningún archivo abierto";
    in property <[string]> tables;
    in property <int> active-table: -1;
    in property <string> header-title: "—";
    in property <string> header-info: "";
    in property <[string]> columns;
    in property <[[string]]> rows;
    in property <int> page: 0;
    in property <int> total-pages: 0;
    in property <bool> paging-enabled: false;
    in property <string> status: "Listo";
    in property <bool> status-error: false;
    in-out property <string> sql-text: "SELECT * FROM sqlite_master;";
    in-out property <bool> sql-open: true;

    callback open-file();
    callback select-table(int);
    callback prev-page();
    callback next-page();
    callback run-sql(string);

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // ----- Sidebar -----
            Rectangle {
                width: 210px;
                background: Theme.sidebar;
                VerticalLayout {
                    // Marca
                    HorizontalLayout {
                        padding: 10px;
                        padding-bottom: 6px;
                        spacing: 6px;
                        Text { text: "◆"; color: Theme.accent; font-size: Theme.fs; vertical-alignment: center; }
                        Text { text: "SQLITE VIEWER"; color: Theme.text-strong; font-size: Theme.fs-small; font-weight: 700; letter-spacing: 0.8px; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        padding-left: 10px; padding-right: 10px; padding-bottom: 10px;
                        spacing: 8px;
                        Btn { text: "Abrir base de datos"; icon: "＋"; primary: true; clicked => { root.open-file(); } }
                        // Archivo actual
                        Rectangle {
                            height: 26px;
                            border-radius: Theme.radius;
                            background: Theme.panel;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                Text { text: "🗎"; color: Theme.muted; font-size: Theme.fs-small; vertical-alignment: center; }
                                Text {
                                    text: root.file-name; color: Theme.text; font-size: Theme.fs-small;
                                    overflow: elide; vertical-alignment: center; horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 4px;
                        SectionLabel { text: "TABLAS"; vertical-alignment: center; horizontal-stretch: 1; }
                        Badge { text: root.tables.length; }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for t[i] in root.tables: TableItem {
                                name: t;
                                active: i == root.active-table;
                                clicked => { root.select-table(i); }
                            }
                        }
                    }
                }
                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            }

            // ----- Panel principal -----
            VerticalLayout {
                horizontal-stretch: 1;

                // Cabecera / barra de herramientas
                Rectangle {
                    height: 38px;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            alignment: start;
                            Text { text: root.header-title; color: Theme.text-strong; font-size: 13px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                            VerticalLayout { alignment: center; Badge { text: root.header-info; } }
                        }
                        if root.paging-enabled: HorizontalLayout {
                            spacing: 4px;
                            alignment: end;
                            VerticalLayout { alignment: center; Btn { icon: "‹"; enabled: root.page > 0; clicked => { root.prev-page(); } } }
                            Text {
                                text: (root.page + 1) + " / " + max(1, root.total-pages);
                                color: Theme.muted; font-size: Theme.fs-small;
                                vertical-alignment: center; horizontal-alignment: center; min-width: 56px;
                            }
                            VerticalLayout { alignment: center; Btn { icon: "›"; enabled: root.page + 1 < root.total-pages; clicked => { root.next-page(); } } }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                DataTable {
                    vertical-stretch: 1;
                    columns: root.columns;
                    rows: root.rows;
                    row-offset: root.paging-enabled ? root.page * 50 : 0;
                }

                // Panel SQL colapsable
                Rectangle { height: 1px; background: Theme.border-strong; }
                Rectangle {
                    height: 24px;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px;
                        spacing: 6px;
                        Text {
                            text: root.sql-open ? "▾" : "▸";
                            color: Theme.muted; font-size: Theme.fs-small; vertical-alignment: center;
                        }
                        SectionLabel { text: "CONSULTA SQL"; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.sql-open = !root.sql-open; } }
                }
                if root.sql-open: Rectangle {
                    height: 110px;
                    background: Theme.sidebar;
                    HorizontalLayout {
                        padding: 6px;
                        spacing: 6px;
                        TextEdit {
                            horizontal-stretch: 1;
                            text <=> root.sql-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        VerticalLayout {
                            alignment: start;
                            Btn { icon: "▶"; text: "Ejecutar"; primary: true; clicked => { root.run-sql(root.sql-text); } }
                        }
                    }
                }
            }
        }

        // Barra de estado (ancho completo)
        Rectangle {
            height: 20px;
            background: root.status-error ? Theme.error-bg : Theme.accent-bg;
            animate background { duration: 150ms; }
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px;
                spacing: 6px;
                Text { text: root.status-error ? "✕" : "✓"; color: #ffffff; font-size: Theme.fs-tiny; vertical-alignment: center; }
                Text { text: root.status; color: #ffffff; font-size: Theme.fs-small; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Text { text: "SQLite"; color: #ffffffb0; font-size: Theme.fs-tiny; vertical-alignment: center; }
            }
        }
    }
}
